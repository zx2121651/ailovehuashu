<template>
  <view class="container flex-col h-full fade-in">
    <!-- Header -->
    <view class="header-bar bg-white px-4 py-3 border-b border-gray-100 flex-row items-center justify-between z-20">
      <view class="p-2" @click="goBack">
        <text class="text-xl text-gray-800">‹</text>
      </view>
      <text class="text-base font-bold text-gray-800">恋爱人格测评</text>
      <view class="header-right"></view>
    </view>

    <scroll-view class="flex-1 px-4 py-5" scroll-y>

      <!-- 第 0 步 欢迎 -->
      <view v-if="step === 0" class="items-center flex-col pt-4 animate-fade-in-up">
        <view class="palette-logo rounded-3xl items-center justify-center mb-5 animate-float">
          <text class="palette-logo-text">💗</text>
        </view>
        <text class="text-2xl font-extrabold text-gray-800 mb-2">了解你的恋爱性格</text>
        <text class="text-gray-500 text-sm text-center leading-relaxed mb-8">5 道题，测出你的恋爱人格画像，<br/>并让 AI 为你定制专属开场白与回复风格。</text>
        <view class="start-btn bg-gradient-pink rounded-full py-3 items-center tap-press" @click="startQuiz">
          <text class="text-white text-base font-bold">开始测评（约30秒）</text>
        </view>
        <view v-if="localPalette" class="items-center mt-3" @click="showResult">
          <text class="text-pink-500 text-xs font-medium">🔄 重新查看结果</text>
        </view>
      </view>

      <!-- 第 1 步 答题 -->
      <view v-if="step === 1" class="animate-fade-in-up">
        <view class="flex-row items-center mb-4">
          <text class="text-xs text-gray-500 font-medium mr-3">第 {{ qIndex + 1 }} / {{ questions.length }} 题</text>
          <view class="progress-track flex-1 h-1_5 bg-gray-200 rounded-full overflow-hidden">
            <view class="progress-fill h-full bg-gradient-pink rounded-full" :style="{ width: ((qIndex + 1) / questions.length * 100) + '%' }"></view>
          </view>
        </view>

        <view class="bg-white rounded-3xl p-5 shadow-sm border border-gray-50">
          <text class="text-base font-bold text-gray-800 leading-relaxed mb-6">{{ questions[qIndex].q }}</text>
          <view class="flex-col">
            <view v-for="(op, i) in questions[qIndex].options" :key="i"
              class="option-btn border border-gray-100 bg-gray-50 rounded-2xl px-4 py-3_5 mb-3 tap-press"
              @click="pick(op.v)">
              <text class="text-sm text-gray-700 font-medium">{{ i + 1 }}. {{ op.t }}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 第 2 步 结果 -->
      <view v-if="step === 2 && result" class="items-center flex-col animate-fade-in-up">
        <text class="result-emoji mb-3 animate-pop">{{ result.emoji || '💘' }}</text>
        <text class="text-2xl font-extrabold text-gray-800 mb-1">你是「{{ result.type }}」</text>
        <view class="flex-row mt-3 mb-5">
          <view v-for="(t, i) in (result.traits || [])" :key="i" class="trait-tag bg-pink-100 rounded-full px-3 py-1 mr-2">
            <text class="text-pink-600 text-xs font-medium">{{ t }}</text>
          </view>
        </view>

        <view class="w-full bg-white rounded-3xl p-5 shadow-sm border border-gray-50 mb-4">
          <text class="text-gray-600 text-sm leading-relaxed">{{ result.desc }}</text>
        </view>

        <view class="w-full rounded-3xl p-5 mb-5 border border-pink-100 bg-pink-50">
          <text class="text-pink-500 font-bold text-sm mb-2">✨ AI · 为你定制的开场白</text>
          <text class="text-gray-800 text-sm leading-relaxed mb-3">{{ result.aiSuggestion?.opening || result.opening }}</text>
          <view class="copy-btn bg-pink-500 rounded-lg px-3 py-2 w-max tap-press" @click="copyOpening(result.aiSuggestion?.opening || result.opening)">
            <text class="text-white text-xs font-bold">{{ copiedOpening ? '✔ 已复制' : '复制这句开场' }}</text>
          </view>
        </view>

        <view class="w-full flex-row mb-6">
          <view class="act-btn bg-gradient-pink rounded-2xl py-3 items-center flex-1 tap-press mr-2" @click="goToAI">
            <text class="text-white text-sm font-bold">带去 AI 定制</text>
          </view>
          <view class="act-btn bg-white border border-pink-200 rounded-2xl py-3 items-center flex-1 tap-press" @click="startQuiz">
            <text class="text-pink-500 text-sm font-bold">重新测评</text>
          </view>
        </view>
      </view>

    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { useAppStore } from '../../store/app.uts'
import { getAssessmentQuestions, submitAssessment } from '../../services/api.uts'

const appStore = useAppStore

// 本地问卷（后端在线时用 /life/assessment/questions，否则用此份）
const LOCAL_QUESTIONS = [
  { id: 1, q: '和喜欢的人冷场了，你的第一反应是？', options: [{ v: 'a', t: '主动换个话题暖场' }, { v: 'b', t: '抛个幽默段子试探' }, { v: 'c', t: '直接问对方想聊什么' }] },
  { id: 2, q: 'TA 发来一句负能量抱怨，你会怎么接？', options: [{ v: 'a', t: '共情安慰，先稳住情绪' }, { v: 'b', t: '幽默化解 逗TA开心' }, { v: 'c', t: '给出解决办法并约见面' }] },
  { id: 3, q: '表白被拒绝了，你会？', options: [{ v: 'a', t: '温柔表达理解 继续陪伴' }, { v: 'b', t: '优雅退后 保留余味联系' }, { v: 'c', t: '坦诚心意 到此不再纠缠' }] },
  { id: 4, q: '聊天中你最看重的是？', options: [{ v: 'a', t: 'TA 的情绪和感受' }, { v: 'b', t: '聊天的节奏和趣味' }, { v: 'c', t: '关系和进度的发展' }] },
  { id: 5, q: '朋友甩来一道恋爱难题，你更倾向怎么解？', options: [{ v: 'a', t: '让彼此都舒服' }, { v: 'b', t: '显得从容有魅力' }, { v: 'c', t: '快速推进关系' }] }
]

const PALETTES = [
  { type: '浪漫画家', emoji: '🎨', traits: ['共情', '细腻', '浪漫'], style: '暖心情话', desc: '你有敏锐的情绪雷达，适合用走心情话升温。', opening: '嗨，我猜你今天心情不错——因为遇见好天气的人眼里会有光。' },
  { type: '理性推拉大师', emoji: '♟️', traits: ['策略', '幽默', '推拉'], style: '幽默接梗', desc: '你擅长制造张弛有度的聊天节奏。', opening: '通常我不会轻易加人，但你这条动态挺特别。' },
  { type: '阳光行动派', emoji: '🌞', traits: ['主动', '真诚', '直接'], style: '直球勇', desc: '你热情直接，最擅长把心动变成行动。', opening: '第一眼就被你吸引了，周末有空的话想约你喝杯咖啡。' }
]

const step = ref(0) // 0=欢迎 1=答题 2=结果
const qIndex = ref(0)
const questions = ref<any[]>(LOCAL_QUESTIONS)
const answers = ref<any[]>([])
const result = ref<any>(null)
const copiedOpening = ref(false)
const localPalette = ref(appStore.lovePalette || null)

// 后端在线时拉取最新题目
try {
  getAssessmentQuestions().then((list: any[]) => {
    if (list && list.length > 0) {
      questions.value = list
    }
  }).catch(() => {})
} catch (e) { }

const startQuiz = () => {
  answers.value = []
  qIndex.value = 0
  step.value = 1
}

const pick = async (v: string) => {
  answers.value.push({ id: questions.value[qIndex.value].id, v })
  if (qIndex.value + 1 < questions.value.length) {
    qIndex.value = qIndex.value + 1
  } else {
    await submit(answers.value)
  }
}

const submit = async (finalAnswers: any[]) => {
  try {
    const res = await submitAssessment(finalAnswers)
    const withType = {
      type: res.type,
      emoji: res.emoji,
      traits: res.traits || [],
      desc: res.desc,
      opening: res.opening,
      aiSuggestion: res.aiSuggestion || { opening: res.opening, style: res.style }
    }
    // 持久化到全局 store，供 AI 页个性化
    appStore.setLovePalette(withType)
    result.value = withType
    localPalette.value = withType
    step.value = 2
  } catch (e) {
    // 本地判型兜底（共情a/策略b/行动c）
    let a = 0, b = 0, c = 0
    finalAnswers.forEach((ans) => {
      if (ans.v === 'a') a++
      else if (ans.v === 'b') b++
      else if (ans.v === 'c') c++
    })
    const type = c >= Math.max(a, b) && c > 0 ? '阳光行动派' : (b >= a ? '理性推拉大师' : '浪漫画家')
    const palette = PALETTES.find(p => p.type === type)
    const withType = { ...palette, aiSuggestion: { opening: palette.opening, style: palette.style } }
    appStore.setLovePalette(withType)
    result.value = withType
    localPalette.value = withType
    step.value = 2
  }
}

const showResult = () => {
  step.value = 2
  result.value = localPalette.value || result.value
}

const copyOpening = (text: string) => {
  uni.setClipboardData({
    data: text,
    success: () => {
      copiedOpening.value = true
      appStore.showToast('开场白已复制')
      setTimeout(() => { copiedOpening.value = false }, 2000)
    }
  })
}

const goToAI = () => {
  appStore.showToast('已携带画像去 AI 定制回复')
  uni.navigateTo({ url: '/pages/ai/ai' })
}

const goBack = () => {
  uni.navigateBack({ delta: 1 })
}
</script>

<style>
page { display: flex; flex-direction: column; height: 100%; background-color: #f5f7fa; }
.container { flex: 1; background-color: #f5f7fa; }

/* Header */
.header-bar { height: 50px; }
.header-right { width: 32px; }

/* 欢迎页 logo */
.palette-logo { width: 88px; height: 88px; background-image: linear-gradient(to bottom right, #f472b6, #db2777); box-shadow: 0 8px 24px -4px rgba(244,114,182,0.5); }
.palette-logo-text { font-size: 40px; }
.start-btn { width: 220px; }

/* 答题进度条 */
.progress-track { height: 6px; }
.progress-fill { width: 0%; transition: width 0.3s ease; }

/* 结果页 */
.result-emoji { font-size: 56px; }
.trait-tag { }
.copy-btn { }

/* 按钮 action */
.act-btn { }

/* 工具类补齐 */
.mt-3 { margin-top: 12px; }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 12px; }
.mb-4 { margin-bottom: 16px; }
.mb-5 { margin-bottom: 20px; }
.mb-6 { margin-bottom: 24px; }
.mr-2 { margin-right: 8px; }
.mr-3 { margin-right: 12px; }
.pt-4 { padding-top: 16px; }
.py-3_5 { padding-top: 14px; padding-bottom: 14px; }
.h-1_5 { height: 6px; }
.text-2xl { font-size: 24px; }
.text-base { font-size: 16px; }
.text-sm { font-size: 14px; }
.text-xs { font-size: 12px; }
.font-bold { font-weight: bold; }
.font-extrabold { font-weight: 800; }
.font-medium { font-weight: 500; }
.w-max { width: max-content; }
.bg-pink-100 { background-color: #fce7f3; }
.border-pink-200 { border-color: #fbcfe8; border-width: 1px; border-style: solid; }
.border-pink-100 { border-color: #fce7f3; border-width: 1px; border-style: solid; }
.text-pink-500 { color: #ec4899; }
.text-pink-600 { color: #db2777; }
.border-gray-50 { border-color: #f9fafb; }
.border-gray-100 { border-color: #f3f4f6; }
.border-gray-200 { border-color: #e5e7eb; }
.bg-gray-200 { background-color: #e5e7eb; }
.bg-gray-50 { background-color: #f9fafb; }
.text-gray-800 { color: #1f2937; }
.text-gray-700 { color: #374151; }
.text-gray-600 { color: #4b5563; }
.text-gray-500 { color: #6b7280; }
.text-gray-400 { color: #9ca3af; }
.leading-relaxed { line-height: 1.625; }
</style>
